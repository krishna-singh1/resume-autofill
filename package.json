{
  "name": "resume-autofill",
  "version": "0.1.0",
  "private": true,
  "description": "Chrome extension that fills job applications from your resume and remembers answers you type once.",
  "type": "module",
  "scripts": {
    "test": "node --test \"tests/*.test.js\"",
    "test:e2e": "node tests/e2e/run.mjs",
    "icons": "node scripts/make-icons.mjs",
    "check": "node scripts/check-syntax.mjs",
    "parse": "node scripts/parse-file.mjs",
    "package": "node scripts/package.mjs",
    "screenshots": "node scripts/screenshots.mjs"
  },
  "engines": {
    "node": ">=20"
  }
}
